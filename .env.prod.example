# Production environment for docker-compose.prod.yml.
# Copy to .env.prod at /opt/blog on the host and fill in the blanks — never
# commit it. Loaded into the api and front containers (the admin image is
# static and needs nothing at runtime).
#
# DATABASE_URL, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY come straight from
# the Terraform outputs: terraform output database_url / s3_access_key_id /
# s3_secret_access_key.

# --- Core ---
API_PORT=4201
CORS_ORIGINS=https://mikhailbahdashych.me,https://admin.mikhailbahdashych.me
# Swagger UI at /api/docs. Off in production: it publishes the full admin
# surface (routes, payload shapes, validation rules) to anonymous visitors.
# Set to 'true' only if you deliberately want the docs public.
SWAGGER_ENABLED=false

# --- Database (RDS; TLS verified against the CA bundle baked into the image) ---
DATABASE_URL=postgres://USER:PASSWORD@YOUR-RDS-HOST.eu-central-1.rds.amazonaws.com:5432/personal_blog
DATABASE_SSL=true

# --- Auth (generate each secret with: openssl rand -hex 32) ---
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- S3 (image/asset storage) ---
# Keys are content hashes, so dev and production would collide on identical
# files. The prefix keeps them apart; never point this at 'dev', which the dev
# seeder empties on every run.
S3_REGION=eu-central-1
S3_BUCKET=bahdashych-on-security
S3_KEY_PREFIX=prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://bahdashych-on-security.s3.eu-central-1.amazonaws.com

# --- Frontend integration (container network addresses) ---
# API address the frontend calls server-side
API_INTERNAL_URL=http://api:4201
# Frontend address the API calls to trigger cache revalidation
FRONT_INTERNAL_URL=http://front:3000
# Shared secret guarding the revalidation webhook — must match on both sides.
REVALIDATE_SECRET=

# --- Public URLs ---
# Inlined into the client bundle at image build time, but ALSO read at runtime
# by server components through dynamic env access — so they must be here too.
NEXT_PUBLIC_SITE_URL=https://mikhailbahdashych.me
NEXT_PUBLIC_API_URL=https://api.mikhailbahdashych.me
